# 服务端运行配置（复制为 .env 后按需修改，禁止提交 .env）
PORT=9527
APP_NAME=ai-fullstack-lab-api
APP_ENV=development
APP_VERSION=0.1.0
CORS_ORIGIN=http://localhost:5173

# 模型供应商（第 3 周起使用，密钥只允许放在服务端）
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=

# 数据库连接串（PostgreSQL）
# 本地开发：先建 SSH 隧道 ssh -N -L 55432:127.0.0.1:5432 ubuntu@<server>，再连 127.0.0.1:55432
# 生产部署：用服务器本机地址 127.0.0.1:5432，库名与账号由部署脚本注入
DATABASE_URL="postgresql://user:password@127.0.0.1:55432/ai_lab?schema=public"

# JWT 签名密钥：至少 16 位，生产必须用随机长串（openssl rand -hex 32）
# access 与 refresh 必须使用不同密钥，避免一种令牌被当成另一种使用
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
