# 服务端运行配置（复制为 .env 后按需修改，禁止提交 .env）
PORT=9527
APP_NAME=ai-fullstack-lab-api
APP_ENV=development
APP_VERSION=1.0.0
CORS_ORIGIN=http://localhost:5173

# DeepSeek 官方模型（密钥只允许放在服务端，禁止写入前端或提交仓库）
# OpenAI SDK 仅作为兼容协议客户端，实际请求发往 api.deepseek.com。
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
# 采样与调用限制：温度范围 0~2；maxTokens 和 timeoutMs 必须为正整数
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048
MODEL_TIMEOUT_MS=30000
# 切换其他 OpenAI 兼容服务时，将 MODEL_PROVIDER 改为 openai-compatible，
# 并显式替换 MODEL_BASE_URL、MODEL_NAME 和对应的 MODEL_API_KEY。

# 多模型档案（Week 4 Day 1）：MODEL_PROFILES 是逗号分隔的公开别名，客户端只能用别名切换。
# 未配置时自动生成一个 id=default 的档案，行为与 Week 3 相同。
# 每个档案继承上面的 MODEL_PROVIDER / MODEL_BASE_URL / MODEL_API_KEY / 采样参数，可覆盖：
# LABEL / PROVIDER / BASE_URL / MODEL / API_KEY_ENV / TEMPERATURE / MAX_TOKENS /
# TIMEOUT_MS / CONTEXT_WINDOW / STREAMING
MODEL_PROFILES=deepseek-chat,deepseek-reasoner
MODEL_DEFAULT_PROFILE=deepseek-chat
MODEL_PROFILE_DEEPSEEK_CHAT_LABEL=DeepSeek Chat
MODEL_PROFILE_DEEPSEEK_CHAT_MODEL=deepseek-chat
MODEL_PROFILE_DEEPSEEK_CHAT_CONTEXT_WINDOW=65536
MODEL_PROFILE_DEEPSEEK_REASONER_LABEL=DeepSeek Reasoner
MODEL_PROFILE_DEEPSEEK_REASONER_MODEL=deepseek-reasoner
MODEL_PROFILE_DEEPSEEK_REASONER_TEMPERATURE=0.2
MODEL_PROFILE_DEEPSEEK_REASONER_CONTEXT_WINDOW=65536
# 如果某个模型使用独立密钥，只在这里写变量名，密钥本身仍放在环境变量中：
# MODEL_PROFILE_DEEPSEEK_REASONER_API_KEY_ENV=MODEL_REASONER_API_KEY

# 模型调用可靠性（Week 4 Day 4）：超时 / 有限重试 / 并发限制 / 熔断
# 单次尝试时间预算（毫秒），到点会主动取消上游请求
AI_CALL_TIMEOUT_MS=30000
# 单次逻辑请求最多尝试次数（含首次），范围 1~5
AI_MAX_ATTEMPTS=3
# 指数退避基数与上限（毫秒），实际等待在 50%~100% 之间抖动
AI_RETRY_BASE_MS=200
AI_RETRY_MAX_MS=2000
# 同时在途的模型调用上限；超出后最多排队这么久
AI_MAX_CONCURRENCY=4
AI_QUEUE_TIMEOUT_MS=5000
# 连续失败多少次后熔断，以及熔断后的冷却时间
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_MS=30000

# Embedding（Week 5 Day 4）：与聊天模型分开配置。
# DeepSeek 聊天接口不提供 Embedding，需使用支持 OpenAI Embeddings 协议的服务，
# 例如 OpenAI（text-embedding-3-small）、SiliconFlow（BAAI/bge-m3）、
# DashScope 兼容模式（text-embedding-v3）等。
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
# 可选：部分服务支持降维；留空表示使用模型默认维度
# EMBEDDING_DIMENSIONS=1536
# 单次请求最多发送多少段文本，范围 1~128
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=30000

# 数据库连接串（PostgreSQL）
# 本地开发：先建 SSH 隧道 ssh -N -L 55432:127.0.0.1:5432 ubuntu@<server>，再连 127.0.0.1:55432
# 生产部署：用服务器本机地址 127.0.0.1:5432，库名与账号由部署脚本注入
DATABASE_URL="postgresql://user:password@127.0.0.1:55432/ai_lab?schema=public"

# JWT 签名密钥：至少 16 位，生产必须用随机长串（openssl rand -hex 32）
# access 与 refresh 必须使用不同密钥，避免一种令牌被当成另一种使用
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 登录限流（进程内存实现，多实例部署请改用 Redis）
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
