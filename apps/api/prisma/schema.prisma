// ============================================================================
// Prisma Schema —— 整个数据层的"唯一真相"
//
// 这个文件声明：
//   1. 连哪个数据库（datasource）
//   2. 生成什么客户端（generator）
//   3. 有哪些表、字段、关系、索引（model）
//
// 工作流：
//   改这个文件 → pnpm db:migrate（生成并执行 SQL）→ pnpm db:generate（生成类型）
// 数据库结构因此和代码一起被 Git 版本化，新人 clone 后一条命令即可得到一致结构。
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 连接串来自环境变量，绝不写死在代码里（第 1 周的老规矩：密钥不进仓库）
  // 本地开发通过 SSH 隧道：127.0.0.1:55432 → 服务器 127.0.0.1:5432
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 枚举：数据库层面约束取值范围，比应用层 if 判断更可靠
// ---------------------------------------------------------------------------

/// 用户角色，第 3 天做 RBAC 时直接复用
enum Role {
  ADMIN
  MEMBER
}

/// 消息角色，对应大模型 API 的 role 字段
enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

/// 文档处理状态：先入库、再切片向量化、最后标记 READY
enum DocumentStatus {
  PENDING
  READY
  FAILED
}

// ---------------------------------------------------------------------------
// 用户表
// ---------------------------------------------------------------------------
model User {
  /// cuid()：可排序、分布式唯一、不泄露业务量（自增 ID 会暴露用户数）
  id               String   @id @default(cuid())
  /// @unique 会在数据库上建唯一索引，是"邮箱不能重复"的最终保障
  email            String   @unique
  name             String
  /// 只存哈希，永不存明文密码（第 3 天用 argon2 生成）
  /// 可为空：管理员通过接口创建的账号，在用户自行设置密码前没有凭证
  passwordHash     String?
  role             Role     @default(MEMBER)
  /// Refresh Token 的 SHA-256 哈希。不存原文：数据库泄露时攻击者也无法直接使用。
  /// 每次刷新都会覆盖，实现"同一时刻只有一把有效 refresh token"。
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  /// @updatedAt 由 Prisma 在每次 update 时自动写入
  updatedAt        DateTime @updatedAt

  conversations Conversation[]
  usageLogs     UsageLog[]

  /// @@map 让数据库表名保持蛇形复数（users），代码里仍用 User
  @@map("users")
}

// ---------------------------------------------------------------------------
// 会话表
// ---------------------------------------------------------------------------
model Conversation {
  id                 String   @id @default(cuid())
  title              String   @default("新对话")
  userId             String
  /// 历史摘要：更早的对话压缩后的事实记忆，仅服务端使用，不返回给前端
  historySummary     String?  @db.Text
  /// 已被摘要覆盖的历史消息条数（按时间从最早开始）。0 表示尚无摘要
  summarizedMessages Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  /// 关系字段：onDelete: Cascade 表示删用户时会话一起删
  /// 这个决定必须在建模时做出，否则数据库会用默认行为（这里是 Restrict）
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  usageLogs UsageLog[]

  /// 复合索引："查某个用户的会话列表，按更新时间倒序"是最高频查询
  @@index([userId, updatedAt])
  @@map("conversations")
}

// ---------------------------------------------------------------------------
// 消息表
// ---------------------------------------------------------------------------
model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  /// @db.Text：PostgreSQL 里 text 无长度上限，适合存长文本
  content        String      @db.Text
  /// 记录 token 数，第 3 周做成本统计
  tokens         Int         @default(0)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// 按会话拉取消息并按时间排序，是第二高频查询
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// 用量日志表（Week 3 Day 6）
//
// 只记录元数据：模型、模板、Token 数和耗时。绝不记录消息原文或密钥，
// 避免把用户内容再复制一份到日志表里扩大泄露面。
// 会话删除后日志保留（conversationId 置空），用于长期成本统计。
// ---------------------------------------------------------------------------
model UsageLog {
  id               String   @id @default(cuid())
  userId           String
  conversationId   String?
  /// 供应商实际返回的模型名（可能与应用配置的别名不同）
  model            String
  /// 使用的 Prompt 模板 ID
  template         String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  /// 从发出请求到流结束的毫秒数，用于观察首包与整体延迟
  latencyMs        Int      @default(0)
  createdAt        DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("usage_logs")
}

// ---------------------------------------------------------------------------
// 知识库文档与切片（Week 5 Day 5）
//
// 一条 Document 对应一次上传；DocumentChunk 是切片后的最小检索单元。
// embedding 使用 pgvector 的 vector(1536)，必须与 Embedding 模型维度一致：
// - 默认 text-embedding-3-small 是 1536 维；
// - 若换成 1024 维模型（如 bge-m3），需要修改本字段并重新生成迁移、重建索引。
//
// Prisma 不支持直接读写 vector 字段（Unsupported），写入与相似度查询都走原生 SQL。
// ---------------------------------------------------------------------------
model Document {
  id         String         @id @default(cuid())
  title      String
  filename   String
  mimeType   String
  format     String
  status     DocumentStatus @default(PENDING)
  charCount  Int            @default(0)
  blockCount Int            @default(0)
  /// 解析器返回的来源元数据（PDF Info、文本编码等）
  metadata   Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  chunks DocumentChunk[]

  /// 后台任务常按状态扫描待处理文档
  @@index([status, createdAt])
  @@map("documents")
}

model DocumentChunk {
  id           String                      @id @default(cuid())
  documentId   String
  /// 文档内顺序，与 DocumentChunk 的 index 对应
  chunkIndex   Int
  content      String                      @db.Text
  /// PDF 页码；其它格式为空
  page         Int?
  pageEnd      Int?
  /// 标题路径，例如 ["差旅制度", "住宿标准"]
  sectionPath  Json
  /// 来源解析块序号，用于回溯原文
  blockIndexes Json
  tokenCount   Int                         @default(0)
  /// 向量维度必须与迁移中的 vector(1536) 一致
  embedding    Unsupported("vector(1536)")
  createdAt    DateTime                    @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}
