{
  "name": "@ai-lab/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @ai-lab/ai-core build && pnpm build && node --test tests/ai-chat.test.cjs tests/ai-models.test.cjs tests/ai-structured.test.cjs tests/ai-stream.test.cjs tests/ai-conversation.test.cjs tests/conversation-memory.test.cjs tests/tools.test.cjs tests/reliability.test.cjs tests/vector-store.test.cjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@ai-lab/ai-core": "workspace:^",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.1.1",
    "@prisma/client": "^6.16.2",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "openai": "^6.49.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prisma": "6.16.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
