{
  "name": "@ai-lab/rag",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test tests/parser.test.cjs tests/chunking.test.cjs tests/embedding.test.cjs tests/retrieval.test.cjs",
    "embed:corpus": "pnpm build && node scripts/embed-corpus.cjs",
    "compare:retrieval": "pnpm build && node scripts/compare-retrieval.cjs"
  },
  "dependencies": {
    "mammoth": "^1.10.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pdf-parse": "^1.1.1",
    "eslint": "^10.14.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
